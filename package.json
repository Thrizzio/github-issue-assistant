{
  "name": "issuepilot",
  "version": "1.0.0",
  "description": "Codebase Archaeology & Contributor Reconnaissance CLI",
  "type": "module",
  "main": "./dist/cli/index.js",
  "bin": {
    "issuepilot": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"README.md\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"README.md\"",
    "start": "tsx src/cli/index.ts"
  },
  "keywords": [
    "github",
    "issue",
    "reconnaissance",
    "archaeology",
    "ast",
    "ts-morph",
    "typescript",
    "developer-tools"
  ],
  "author": "IssuePilot Contributors",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "ts-morph": "^25.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  }
}
